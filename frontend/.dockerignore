# ─── Build artifacts ──────────────────────────────────────────────────────────
.next
out
build
dist

# ─── Dependencies (installed fresh during Docker build) ───────────────────────
node_modules

# ─── Git / Version control ────────────────────────────────────────────────────
.git
.gitignore
.github

# ─── Environment files (never bake secrets into the image) ────────────────────
.env
.env.*
!.env.example

# ─── Dev tooling ──────────────────────────────────────────────────────────────
.husky
.prettierrc
.prettierignore
eslint.config.mjs

# ─── Test files ───────────────────────────────────────────────────────────────
**/*.test.ts
**/*.test.tsx
**/*.spec.ts
**/*.spec.tsx
vitest.config.ts
vitest.setup.ts
__tests__
coverage

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*

# ─── IDE / OS ─────────────────────────────────────────────────────────────────
.vscode
.idea
.DS_Store
Thumbs.db

# ─── Docs ─────────────────────────────────────────────────────────────────────
*.md
!README.md

# ─── TypeScript build info (regenerated by Docker build) ──────────────────────
*.tsbuildinfo

# ─── CI/CD files (not needed inside container) ────────────────────────────────
Jenkinsfile
Dockerfile
.dockerignore
